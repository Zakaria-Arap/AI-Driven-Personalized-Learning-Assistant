NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MySQL (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=somo_dev
DB_USER=somo
DB_PASSWORD=somopass

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
GOOGLE_CLIENT_ID=

# AI tutor: "mock" works offline with no key. "anthropic" calls the model API.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=
AI_DAILY_MESSAGE_LIMIT=40

# Email settings
MAIL_PROVIDER=log
# MAIL_PROVIDER=smtp   # Use smtp to send real emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
MAIL_FROM=noreply@somo.example.com

# Mail provider: "log" (console only) or "smtp" (send via SMTP)
MAIL_PROVIDER=log
# SMTP server hostname
SMTP_HOST=smtp.example.com
# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587
# SMTP authentication username
SMTP_USER=user@example.com
# SMTP authentication password
SMTP_PASS=password
# From address for outgoing emails
MAIL_FROM=noreply@somo.local

# Test database name (defaults to {DB_NAME}_test)
DB_NAME_TEST=somo_dev_test
